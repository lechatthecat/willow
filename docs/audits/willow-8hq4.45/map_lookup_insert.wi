// Reconstructed: 3M inserts, followed by 12M successful lookups.
import std::collections::Map;
fn main() {
 let values: Map<i64, i64> = Map::new();
 let mut i = 0;
 let mut sum = 0;
 println("@start work");
 while i < 3000000 { values.insert(i, i); i = i + 1; }
 i = 0;
 while i < 12000000 { sum = sum + values.get(i % 3000000).unwrap(); i = i + 1; }
 println("@end work");
 println(sum);
}
