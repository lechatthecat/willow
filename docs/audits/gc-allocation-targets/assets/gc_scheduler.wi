import std::collections::Array;
class Point { pub x: i64; pub y: i64; }
async fn worker(done: Channel<i64>) {let ring: Array<Point> = []; let mut i = 0; while i < 2048 { ring.push(new Point(0,0)); i = i + 1; }
 let mut sum = 0; i = 0; while i < 1500000 { let slot = i % 2048; sum = sum + ring[slot].x; ring[slot] = new Point(i,i); i = i + 1; }done.send(sum); }
async fn main() { let done = Channel<i64>::new(); let mut i = 0; println("@start"); while i < 8 { worker(done); i = i + 1; } let mut total = 0; i = 0; while i < 8 { total = total + done.recv(); i = i + 1; } println("@end"); println(total); }