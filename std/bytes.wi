import std::collections::Array;
import std::text;

// Byte-position error from ByteBuffer::decode_utf8: the offset where the
// first invalid UTF-8 sequence starts (all earlier bytes are valid).
pub class Utf8Error {
    pub position: i64;
}

// Growable byte sequence. Each element is an i64 in 0..=255, the same byte
// representation the net byte APIs use, so to_array()/from_array() pass data
// to them without conversion. push, get and set are O(1) (push amortized).
// Fixed-width integers are 8 bytes, two's complement.
pub class ByteBuffer {
    data: Array<i64>;

    pub init(self) {
        self.data = Array::new();
    }

    // Copies values; panics when any element is outside 0..=255.
    pub static fn from_array(values: Array<i64>) -> ByteBuffer {
        let buffer = new ByteBuffer();
        buffer.extend(values);
        return buffer;
    }

    // The UTF-8 encoding of text.
    pub static fn from_string(text: String) -> ByteBuffer {
        let buffer = new ByteBuffer();
        buffer.write_string(text);
        return buffer;
    }

    pub fn len() -> i64 { return self.data.len(); }
    pub fn is_empty() -> bool { return self.data.len() == 0; }

    // Panics when index is out of bounds.
    pub fn get(index: i64) -> i64 { return self.data[index]; }

    pub fn set(index: i64, value: i64) {
        check_byte(value);
        self.data[index] = value;
    }

    pub fn push(value: i64) {
        check_byte(value);
        self.data.push(value);
    }

    pub fn extend(values: Array<i64>) {
        for index in 0..values.len() { self.push(values[index]); }
    }

    pub fn write_string(text: String) {
        for index in 0..text.len() { self.data.push(text.byte_at(index)); }
    }

    pub fn write_i64_le(value: i64) {
        for index in 0..8 { self.data.push((value >> (index * 8)) & 0xFF); }
    }

    pub fn write_i64_be(value: i64) {
        for index in 0..8 { self.data.push((value >> ((7 - index) * 8)) & 0xFF); }
    }

    // Reads 8 bytes starting at offset; panics when they are not all present.
    pub fn read_i64_le(offset: i64) -> i64 {
        self.check_read(offset);
        let mut value = 0;
        for index in 0..8 { value = value | (self.data[offset + index] << (index * 8)); }
        return value;
    }

    pub fn read_i64_be(offset: i64) -> i64 {
        self.check_read(offset);
        let mut value = 0;
        for index in 0..8 { value = (value << 8) | self.data[offset + index]; }
        return value;
    }

    // Independent copy of the half-open range [start, end).
    pub fn slice(start: i64, end: i64) -> ByteBuffer {
        let buffer = new ByteBuffer();
        buffer.data = self.data.slice(start, end);
        return buffer;
    }

    // Independent copy of the bytes.
    pub fn to_array() -> Array<i64> {
        return self.data.slice(0, self.data.len());
    }

    pub fn clear() {
        self.data = Array::new();
    }

    // Strict UTF-8 decoding: rejects overlong forms, surrogates, values above
    // U+10FFFF and truncated sequences. O(len).
    pub fn decode_utf8() -> Result<String, Utf8Error> {
        let pieces: Array<String> = Array::new();
        let length = self.data.len();
        let mut index = 0;
        while index < length {
            let lead = self.data[index];
            let mut width = 0;
            let mut low = 0x80;
            let mut high = 0xBF;
            if lead < 0x80 {
                width = 1;
            } else if lead >= 0xC2 && lead <= 0xDF {
                width = 2;
            } else if lead >= 0xE0 && lead <= 0xEF {
                width = 3;
                if lead == 0xE0 { low = 0xA0; }
                if lead == 0xED { high = 0x9F; }
            } else if lead >= 0xF0 && lead <= 0xF4 {
                width = 4;
                if lead == 0xF0 { low = 0x90; }
                if lead == 0xF4 { high = 0x8F; }
            }
            if width == 0 || index + width > length { return Err(new Utf8Error(index)); }
            let mut scalar = lead;
            if width == 2 { scalar = lead & 0x1F; }
            if width == 3 { scalar = lead & 0x0F; }
            if width == 4 { scalar = lead & 0x07; }
            for offset in 1..width {
                let next = self.data[index + offset];
                // Only the second byte has a lead-specific range.
                if offset > 1 {
                    low = 0x80;
                    high = 0xBF;
                }
                if next < low || next > high { return Err(new Utf8Error(index)); }
                scalar = (scalar << 6) | (next & 0x3F);
            }
            pieces.push(text::from_scalar(scalar));
            index = index + width;
        }
        return Ok(pieces.join(""));
    }

    // Bytes as a list: [104, 105].
    pub fn to_string() -> String {
        return self.data.to_string();
    }

    fn check_read(offset: i64) {
        // Subtract from the nonnegative length instead of adding to an
        // untrusted offset: even i64::MAX must reach this bounds diagnostic.
        if offset < 0 || offset > self.data.len() - 8 { panic("byte buffer read out of bounds"); }
    }
}

fn check_byte(value: i64) {
    if value < 0 || value > 255 { panic("byte value must be in 0..=255"); }
}
