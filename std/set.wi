import std::collections::{Array, Map};

// Unordered set of scalar or string values. A dense element array plus a hash
// index (element -> slot) gives expected O(1) insert, contains and remove and
// O(n) iteration. Removal moves the last element into the freed slot, so
// values() is in insertion order only until the first removal.
pub class HashSet<T> {
    elements: Array<T>;
    slots: Map<T, i64>;

    pub init(self) {
        self.elements = Array::new();
        self.slots = Map::new();
    }

    pub static fn from_array(values: Array<T>) -> HashSet<T> where T: i8 | i16 | i32 | u16 | u32 | u64 | char | u8 | i64 | f64 | bool | String {
        let set: HashSet<T> = new HashSet();
        for index in 0..values.len() { set.insert(values[index]); }
        return set;
    }

    pub fn len() -> i64 { return self.elements.len(); }
    pub fn is_empty() -> bool { return self.elements.len() == 0; }

    // Returns true when value was not already present. Panics on NaN, which
    // equals no value.
    pub fn insert(value: T) -> bool where T: i8 | i16 | i32 | u16 | u32 | u64 | char | u8 | i64 | f64 | bool | String {
        if value != value { panic("HashSet element must not be NaN"); }
        if self.slots.contains(value) { return false; }
        self.slots.insert(value, self.elements.len());
        self.elements.push(value);
        return true;
    }

    // NaN is never an element (insert rejects it), so it is never found.
    pub fn contains(value: T) -> bool where T: i8 | i16 | i32 | u16 | u32 | u64 | char | u8 | i64 | f64 | bool | String {
        if value != value { return false; }
        return self.slots.contains(value);
    }

    // Returns true when value was present; false for NaN.
    pub fn remove(value: T) -> bool where T: i8 | i16 | i32 | u16 | u32 | u64 | char | u8 | i64 | f64 | bool | String {
        if value != value { return false; }
        if let Some(slot) = self.slots.remove(value) {
            let last = self.elements.pop();
            if slot < self.elements.len() {
                self.elements[slot] = last;
                self.slots.insert(last, slot);
            }
            return true;
        }
        return false;
    }

    pub fn clear() {
        self.elements = Array::new();
        self.slots = Map::new();
    }

    // Snapshot copy in the set's internal order; later changes to the set do
    // not affect it. Use Array::sort() for a numeric ascending order.
    pub fn values() -> Array<T> {
        return self.elements.slice(0, self.elements.len());
    }

    // Set algebra is O(len(self) + len(other)) expected.
    pub fn union(other: HashSet<T>) -> HashSet<T> where T: i8 | i16 | i32 | u16 | u32 | u64 | char | u8 | i64 | f64 | bool | String {
        let result = self.copy();
        for index in 0..other.elements.len() { result.insert(other.elements[index]); }
        return result;
    }

    pub fn intersection(other: HashSet<T>) -> HashSet<T> where T: i8 | i16 | i32 | u16 | u32 | u64 | char | u8 | i64 | f64 | bool | String {
        let result: HashSet<T> = new HashSet();
        for index in 0..self.elements.len() {
            let value = self.elements[index];
            if other.slots.contains(value) { result.insert(value); }
        }
        return result;
    }

    pub fn difference(other: HashSet<T>) -> HashSet<T> where T: i8 | i16 | i32 | u16 | u32 | u64 | char | u8 | i64 | f64 | bool | String {
        let result: HashSet<T> = new HashSet();
        for index in 0..self.elements.len() {
            let value = self.elements[index];
            if !other.slots.contains(value) { result.insert(value); }
        }
        return result;
    }

    pub fn is_subset(other: HashSet<T>) -> bool where T: i8 | i16 | i32 | u16 | u32 | u64 | char | u8 | i64 | f64 | bool | String {
        if self.elements.len() > other.elements.len() { return false; }
        for index in 0..self.elements.len() {
            if !other.slots.contains(self.elements[index]) { return false; }
        }
        return true;
    }

    pub fn copy() -> HashSet<T> where T: i8 | i16 | i32 | u16 | u32 | u64 | char | u8 | i64 | f64 | bool | String {
        let result: HashSet<T> = new HashSet();
        for index in 0..self.elements.len() { result.insert(self.elements[index]); }
        return result;
    }

    // Ascending elements, formatted like Map::to_string: {1, 2, 3}. O(n log n).
    pub fn to_string() -> String where T: i8 | i16 | i32 | u16 | u32 | u64 | char | u8 | i64 | f64 | bool | String {
        let values = self.slots.keys();
        let parts = ["{"];
        for index in 0..values.len() {
            if index > 0 { parts.push(", "); }
            parts.push(values[index].to_string());
        }
        parts.push("}");
        return parts.join("");
    }
}
