{
  "type": "object",
  "required": [
    "schema_version",
    "stream_id",
    "seq",
    "event",
    "code",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "event": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Willow toolchain event schema version 1",
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "file_id",
        "start",
        "end",
        "line",
        "col"
      ],
      "properties": {
        "file_id": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "col": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "path",
        "start",
        "end"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "function": {
      "type": "object",
      "required": [
        "id",
        "module",
        "name",
        "locations",
        "synthetic",
        "fingerprint",
        "body_fingerprint",
        "callees",
        "runtime_effects",
        "unknown",
        "unresolved"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "synthetic": {
          "type": "boolean"
        },
        "fingerprint": {
          "type": "string"
        },
        "body_fingerprint": {
          "type": "string"
        },
        "callees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "unknown": {
          "type": "boolean"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identity": {
          "$ref": "#/$defs/symbolIdentity"
        }
      }
    },
    "impactNode": {
      "type": "object",
      "required": [
        "id",
        "level",
        "distance",
        "graph_distance",
        "runtime_effects",
        "unknown"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "distance": {
          "type": "integer",
          "minimum": 0
        },
        "graph_distance": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "unknown": {
          "type": "boolean"
        },
        "identity": {
          "$ref": "#/$defs/symbolIdentity"
        }
      }
    },
    "impact": {
      "type": "object",
      "required": [
        "revision",
        "nodes",
        "truncated",
        "unknown",
        "edge_visits"
      ],
      "properties": {
        "revision": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/impactNode"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "unknown": {
          "type": "boolean"
        },
        "edge_visits": {
          "type": "integer",
          "minimum": 0
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "target",
              "relation"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/symbolIdentity"
              },
              "target": {
                "$ref": "#/$defs/symbolIdentity"
              },
              "relation": {
                "const": "callee"
              }
            }
          }
        }
      }
    },
    "functionChange": {
      "type": "object",
      "required": [
        "before",
        "after",
        "kind",
        "added_effects",
        "removed_effects",
        "added_callees",
        "removed_callees"
      ],
      "properties": {
        "before": {
          "type": [
            "string",
            "null"
          ]
        },
        "after": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "added",
            "deleted",
            "modified",
            "renamed"
          ]
        },
        "added_effects": {
          "type": "integer",
          "minimum": 0
        },
        "removed_effects": {
          "type": "integer",
          "minimum": 0
        },
        "added_callees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed_callees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "symbolIdentity": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "package",
        "module",
        "symbol"
      ],
      "properties": {
        "package": {
          "type": "object",
          "required": [
            "name",
            "version",
            "revision",
            "source"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": "object"
            }
          }
        },
        "module": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "request.started"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "compiler_version"
            ],
            "properties": {
              "compiler_version": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "diagnostic"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "severity",
              "message",
              "labels",
              "notes",
              "helps",
              "fix_suggestions",
              "cascade",
              "root_cause"
            ],
            "properties": {
              "cascade": {
                "type": "boolean"
              },
              "root_cause": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "message": {
                "type": "string"
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "span",
                    "kind",
                    "message",
                    "path"
                  ],
                  "properties": {
                    "span": {
                      "$ref": "#/$defs/span"
                    },
                    "kind": {
                      "enum": [
                        "Primary",
                        "Secondary"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "path": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "fix_suggestions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "span",
                    "replacement",
                    "message",
                    "path"
                  ],
                  "properties": {
                    "span": {
                      "$ref": "#/$defs/span"
                    },
                    "replacement": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "path": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "helps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "request.finished"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "status",
              "exit_code",
              "message"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "error"
                ]
              },
              "exit_code": {
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "message": {
                "type": "string"
              },
              "location": {
                "description": "Source occurrence that caused a structured edit rejection (edit operations only).",
                "type": "object",
                "required": [
                  "path",
                  "start",
                  "end",
                  "line",
                  "column"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Workspace-relative path."
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "analysis.result"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": "WT0010"
          },
          "data": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "impact",
                  "functions"
                ],
                "properties": {
                  "kind": {
                    "const": "impact"
                  },
                  "impact": {
                    "$ref": "#/$defs/impact"
                  },
                  "functions": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/function"
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "revision",
                  "results"
                ],
                "properties": {
                  "kind": {
                    "const": "query"
                  },
                  "revision": {
                    "type": "string"
                  },
                  "results": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "revision"
                      ]
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "transaction"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "edit.preview",
                      "edit.validated",
                      "edit.applied",
                      "edit.recovered"
                    ]
                  },
                  "transaction": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "changes": {
                    "description": "edit.preview only. --changes full (default) gives before/after text; --changes diff gives one unified diff (three context lines) per file.",
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": [
                            "path",
                            "before",
                            "after"
                          ],
                          "properties": {
                            "path": {
                              "type": "string"
                            },
                            "before": {
                              "type": "string"
                            },
                            "after": {
                              "type": "string"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "path",
                            "diff"
                          ],
                          "properties": {
                            "path": {
                              "type": "string"
                            },
                            "diff": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
