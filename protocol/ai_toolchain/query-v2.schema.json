{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Willow V2 query batch",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "function"
        ],
        "properties": {
          "kind": {
            "const": "symbol-info"
          },
          "revision": {
            "type": "string"
          },
          "function": {
            "type": "string"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "function"
        ],
        "properties": {
          "kind": {
            "const": "references"
          },
          "revision": {
            "type": "string"
          },
          "function": {
            "type": "string"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "function"
        ],
        "properties": {
          "kind": {
            "const": "effects"
          },
          "revision": {
            "type": "string"
          },
          "function": {
            "type": "string"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "file",
          "byte"
        ],
        "properties": {
          "kind": {
            "const": "type-at"
          },
          "revision": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "byte": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "symbols"
          },
          "revision": {
            "type": "string"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "file",
          "byte"
        ],
        "properties": {
          "kind": {
            "const": "symbol-at"
          },
          "revision": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "byte": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    ]
  }
}
