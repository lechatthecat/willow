{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Willow V2 query batch",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "function"
        ],
        "properties": {
          "kind": {
            "const": "symbol-info"
          },
          "revision": {
            "type": "string"
          },
          "function": {
            "type": "string"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "function"
        ],
        "properties": {
          "kind": {
            "const": "references"
          },
          "revision": {
            "type": "string"
          },
          "function": {
            "type": "string"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "function"
        ],
        "properties": {
          "kind": {
            "const": "effects"
          },
          "revision": {
            "type": "string"
          },
          "function": {
            "type": "string"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "file",
          "byte"
        ],
        "properties": {
          "kind": {
            "const": "type-at"
          },
          "revision": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "byte": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "symbols"
          },
          "revision": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Exact declaration name."
          },
          "prefix": {
            "type": "string",
            "description": "Declaration name prefix (case-sensitive)."
          },
          "module": {
            "type": "string",
            "description": "Logical module path of identity.module, e.g. \"market\" or \"app::util\"."
          },
          "symbol_kind": {
            "type": "string",
            "description": "Declaration kind, e.g. function, method, class, enum, interface, field, variant, parameter, binding, import, module."
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "description": "Maximum symbols returned after filtering; total and truncated report the uncapped count."
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "file",
          "byte"
        ],
        "properties": {
          "kind": {
            "const": "symbol-at"
          },
          "revision": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "byte": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "delta"
        ],
        "properties": {
          "kind": {
            "const": "affected"
          },
          "revision": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Caller-supplied test FunctionIds in this snapshot."
          },
          "delta": {
            "type": "object",
            "required": [
              "schema",
              "ok",
              "kind"
            ],
            "properties": {
              "schema": {
                "const": 1
              },
              "ok": {
                "type": "boolean"
              },
              "kind": {
                "const": "package.mutation"
              },
              "packages_added": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "transitive_changes": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    ]
  }
}
