// Reconstructed workload for willow-8hq4.41; not historical benchmark source.
async fn work(shared: AtomicI64, n: i64) {
    let mut i = 0;
    while i < n { let values = [i, i + 1, i + 2, i + 3]; shared.add(values[2]); if i % 100 == 0 { await yield(); } i = i + 1; }
}
async fn main() { let shared = AtomicI64::new(0);
    println("@start work");
    let a = work(shared, 50000); let b = work(shared, 50000);
    let c = work(shared, 50000); let d = work(shared, 50000);
    let e = work(shared, 50000); let f = work(shared, 50000);
    let g = work(shared, 50000); let h = work(shared, 50000);
    await a; await b; await c; await d; await e; await f; await g; await h;
    println("@end work");
println(shared.load()); }
