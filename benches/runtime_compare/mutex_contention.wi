// Newly reconstructed for willow-8hq4.42; not recovered historical source.
// Eight eager tasks, one shared mutex, 200,000 increments each; join all.
async fn work(shared: Mutex<i64>, n: i64) {
    let mut i = 0;
    while i < n { lock shared as mut value { value = value + 1; } i = i + 1; }
}
async fn main() { let shared = Mutex::new(0);
    println("@start work");
    let a = work(shared, 200000); let b = work(shared, 200000);
    let c = work(shared, 200000); let d = work(shared, 200000);
    let e = work(shared, 200000); let f = work(shared, 200000);
    let g = work(shared, 200000); let h = work(shared, 200000);
    await a; await b; await c; await d; await e; await f; await g; await h;
    println("@end work");
lock shared as value { println(value); } }
