fn benchmark_rounds() -> i64 {
    let value = env::arg(0).unwrap();
    if value == "1000" { return 1000; }
    if value == "10000" { return 10000; }
    if value == "100000" { return 100000; }
    if value == "1000000" { return 1000000; }
    return 1000;
}

async fn pong(input: Channel<i64>, output: Channel<i64>, rounds: i64) {
    let mut i = 0;
    while i < rounds {
        input.recv();
        output.send(1);
        i = i + 1;
    }
}

async fn main() {
    let rounds = benchmark_rounds();
    let ping_channel = Channel<i64>::with_capacity(1);
    let pong_channel = Channel<i64>::with_capacity(1);
    let worker = pong(ping_channel, pong_channel, rounds);

    println("START");
    let mut i = 0;
    while i < rounds {
        ping_channel.send(1);
        pong_channel.recv();
        i = i + 1;
    }
    await worker;
    println("END");
}
