class Node {
    pub value: i64;
    pub next: Option<Node>;
}

fn main() {
    let mut list: Option<Node> = None;
    let mut i: i64 = 0;
    while i < 1000000 {
        list = Some(new Node(i, list));
        i = i + 1;
    }

    let mut sum: i64 = 0;
    let mut current = list;
    while current.is_some() {
        let node = current.unwrap();
        sum = sum + node.value;
        current = node.next;
    }
    println(sum);
}
