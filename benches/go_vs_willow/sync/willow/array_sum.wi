import std::collections::Array;

fn main() {
    let values: Array<i64> = [];
    let mut i: i64 = 0;
    while i < 5000000 {
        values.push(i % 1000);
        i = i + 1;
    }

    let mut sum: i64 = 0;
    i = 0;
    while i < values.len() {
        sum = sum + values[i];
        i = i + 1;
    }
    println(sum);
}
