# Agent golden tests compare exact bytes against LF-rendered instructions.
/tests/fixtures/agent/**/*.md text eol=lf
/tests/fixtures/agent/**/*.txt text eol=lf
# Bootstrap golden tests compare exact bytes against LF-generated project files.
/tests/fixtures/init/** text eol=lf
# Raw newlines in example and regression string literals are part of their
# asserted output.
/example/**/*.wi text eol=lf
/tests/regressions/**/*.wi text eol=lf
# Tests instrument the bundled standard library by exact-line rewrites.
/std/**/*.wi text eol=lf
