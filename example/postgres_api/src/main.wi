    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn pg_ssl_request() -> Array<i64>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn pg_start(user: String, database: String) -> Result<Array<i64>, String>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn pg_query(pg: Pg, sql: String, params: Params) -> Result<Array<i64>, String>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn pg_feed(pg: Pg, input: Array<i64>, user: String, password: String) -> Result<Array<i64>, String>;
