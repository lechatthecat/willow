import std::fs;
import std::env;
import std::collections::Array;
extern rust {
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn pg_queries() -> i64;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn param_drops() -> i64;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn pg_drops() -> i64;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn tls_created() -> i64;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn tls_drops() -> i64;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") opaque Tls;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") opaque Http;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn tls_server(cert: String, key: String) -> Result<Tls, String>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn tls_client(cert: String, name: String) -> Result<Tls, String>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn tls_step(tls: Tls, input: Array<i64>) -> Result<Array<i64>, String>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn tls_ready(tls: Tls) -> Result<bool, String>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn tls_send(tls: Tls, text: String) -> Result<Array<i64>, String>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn tls_plain(tls: Tls) -> Result<Array<i64>, String>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn http_new() -> Http;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn http_feed(http: Http, input: Array<i64>, response: bool) -> Result<bool, String>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn http_body(http: Http) -> Result<String, String>;
    nonblocking("77e1e4d5381003f87cc44e8888eff02931cebc1b5d479726cb81d045a715219a") fn http_route(http: Http) -> Result<String, String>;
