// Class -> interface boxing through the LIR-walking backend (willow-j260).
//
// An interface value is not a class pointer: it is a 16-byte GC box holding
// `[concrete object | vtable]`. So putting a `new Item(..)` into anything typed
// `Named` is a real conversion, and the walker now emits it — at `let` init, at
// assignment, at a call argument, at `return`, into an object field, into an
// array element and through `push`.
//
// Reading back through an interface is a separate step, and the walker now
// does that too — see example/lir_interface_dispatch.wi (willow-0g8j.6). Here
// every virtual `n.name()` call stays inside a CLASS METHOD, which compiles
// through its own emitter, so this file keeps isolating the STORE side. Every
// FREE function in it — the ones that build and move the boxes — is compiled
// from the lowered IR.
//
// Building this program with WILLOW_LIR_BACKEND=0 must print exactly the same
// thing, including under WILLOW_GC_STRESS=alloc: the box allocates AFTER its
// value expression is produced, so a site that roots a live temporary across
// the value has to count the box as allocating too. Building it with
// WILLOW_LIR_REQUIRE=1 must succeed, which is the proof that the free
// functions really took the walker path.
//
// The last section covers one object boxed into TWO DIFFERENT interfaces
// (willow-j260.1): a class has one vtable PER INTERFACE, so the two boxes must
// carry different vtables while still holding one shared object.

import std::collections::Array;

interface Named {
    fn name(self) -> String;
}

class Item implements Named {
    pub label: String;

    pub fn name(self) -> String {
        return self.label;
    }
}

class Tag implements Named {
    pub n: i64;

    pub fn name(self) -> String {
        return "#" + self.n.toString();
    }
}

class Holder {
    // Interface-typed fields: each slot holds a box, so every store into one
    // goes through the coercion.
    pub first: Named;
    pub second: Named;

    // Dispatch through the boxes. A class method body, so the walker's
    // "no reading through an interface" rule does not apply here.
    pub fn joined(self) -> String {
        return self.first.name() + "/" + self.second.name();
    }
}

class Roster {
    pub entries: Array<Named>;

    pub fn line(self) -> String {
        let mut out = "";
        let mut i = 0;
        while i < self.entries.len() {
            out = out + self.entries[i].name();
            i = i + 1;
        }
        return out;
    }
}

// `return new Item(..)` from an interface-returning function boxes on the way
// out, with all of the function's roots still live.
fn wrapped(label: String) -> Named {
    return new Item(label);
}

fn tagged(n: i64) -> Named {
    return new Tag(n);
}

// An interface value moved through a `let` and back out needs NO second box:
// it already has the interface representation.
fn relabelled(n: Named) -> Named {
    let x: Named = n;
    return x;
}

// The implicit memberwise constructor boxes each argument into its declared
// field type. The fresh `Holder` is rooted while that happens, which matters
// precisely because the boxes allocate.
fn held(label: String, n: i64) -> Holder {
    return new Holder(new Item(label), new Tag(n));
}

// A widening store into an object field: the owner has to stay rooted across
// the box allocation, not just across the value expression.
fn repointed(h: Holder, label: String) -> Holder {
    h.first = new Item(label);
    return h;
}

// A widening `let`, then a widening assignment to the same interface local.
fn reassigned(label: String, n: i64) -> Named {
    let mut x: Named = new Item(label);
    x = new Tag(n);
    return x;
}

// Array element stores: `push` and index-assign both box, and the array handle
// has to stay rooted across those allocations.
fn collected(xs: Array<Named>, label: String, n: i64) -> i64 {
    xs.push(new Item(label));
    xs.push(new Tag(n));
    xs[0] = new Item(label + "!");
    return xs.len();
}

// A class argument boxed into an interface PARAMETER at the call site, with an
// allocating argument beside it so the first box has to be rooted.
fn pairedUp(label: String, n: i64) -> Holder {
    return new Holder(new Item(label), tagged(n));
}

// ── One object behind TWO interfaces ───────────────────────────────────────
// A class may implement more than one interface, and boxing the SAME object
// into each of them has to pick a DIFFERENT vtable while leaving one shared
// concrete object inside both boxes. Slot 0 of `Ticker` is `tick` and slot 0 of
// `Counted` is `count`, so a box carrying the wrong vtable would call the wrong
// function through the same slot index.

interface Ticker {
    fn tick(self);
}

interface Counted {
    fn count(self) -> i64;
}

class Meter implements Ticker, Counted {
    pub hits: i64;

    pub fn tick(self) {
        self.hits = self.hits + 1;
    }

    pub fn count(self) -> i64 {
        return self.hits;
    }
}

class TwoWay {
    pub ticker: Ticker;
    pub reader: Counted;

    // Mutates through one box and reads back through the OTHER. The count is
    // only right because a box copies a POINTER: both boxes reach one set of
    // fields, so the ticks are visible from the far side.
    pub fn bumpThenRead(self, times: i64) -> i64 {
        let mut i = 0;
        while i < times {
            self.ticker.tick();
            i = i + 1;
        }
        return self.reader.count();
    }
}

// Two boxes over one object inside ONE construction. `emit_new` allocates and
// roots the `TwoWay` before evaluating either argument, so when the second box
// allocates, three things are live at once: the shared object, the first box,
// and the half-initialized owner.
fn twoWays(start: i64) -> TwoWay {
    let m = new Meter(start);
    return new TwoWay(m, m);
}

// The same two methods declared in OPPOSITE order, so the two vtables for
// `Ends` differ only in the order of their entries — the sharpest form of the
// selection question. Resolving a vtable per CLASS instead of per
// (class, interface) makes `head()` answer with the tail.
interface Front {
    fn head(self) -> String;
    fn tail(self) -> String;
}

interface Back {
    fn tail(self) -> String;
    fn head(self) -> String;
}

class Ends implements Front, Back {
    pub a: String;
    pub b: String;

    pub fn head(self) -> String {
        return self.a;
    }

    pub fn tail(self) -> String {
        return self.b;
    }
}

class Pair {
    pub front: Front;
    pub back: Back;

    // Reads each method through BOTH interfaces, so a mixed-up vtable shows up
    // as interleaved output instead of "HHTT".
    pub fn crossed(self) -> String {
        return self.front.head() + self.back.head()
             + self.front.tail() + self.back.tail();
    }
}

fn ends(a: String, b: String) -> Pair {
    let e = new Ends(a, b);
    return new Pair(e, e);
}

// Method calls on SIMPLE classes are direct calls the walker emits itself; the
// virtual dispatch happens inside those method bodies.
fn describe(h: Holder) -> String {
    return h.joined();
}

fn listed(r: Roster) -> String {
    return r.line();
}

fn main() {
    println(describe(held("alpha", 7)));
    println(describe(repointed(held("beta", 8), "gamma")));
    println(describe(pairedUp("delta", 9)));

    let entries: Array<Named> = [wrapped("one"), tagged(2)];
    println(collected(entries, "three", 4));
    println(listed(new Roster(entries)));

    // `main` itself is on the LIR path, so it may not call `.name()` on a
    // `Named` either — it stores the two interface values and lets a class
    // method read them back.
    println(describe(new Holder(relabelled(wrapped("solo")), reassigned("ignored", 11))));

    // One object, two interfaces: the ticks go in through the `Ticker` box and
    // come back out through the `Counted` box.
    println(twoWays(0).bumpThenRead(3));
    println(twoWays(10).bumpThenRead(1));

    // Two vtables that differ only in entry order. "HHTT", never "HTHT".
    println(ends("H", "T").crossed());
}
