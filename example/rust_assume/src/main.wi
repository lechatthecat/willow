import native;

@effects(no_wait, no_io) fn read_and_close() -> i64 {
    let handle = native::make();
    let value = native::Handle_read(handle);
    native::Handle_close(handle);
    return value;
}

async fn main() {
    println(read_and_close());
    let mutex = Mutex::new(0);
    lock mutex as value { println(read_and_close()); }
}
