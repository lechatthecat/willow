// shared_effect_fixpoint.wi — one effect lattice, one fixpoint
// (willow-uqzx.1.3).
//
// Three analyses ask the call graph the same shape of question:
//
//   * may-panic, which decides whether a call needs a `recover` landing pad,
//   * E2604, which decides whether a call may wait while a lock is held,
//   * E0810, which decides whether a sync helper can yield in task context.
//
// They used to own three hand-rolled propagation loops that agreed on nothing:
// not the key space, not the lattice, not what a missing fact means. They now
// share ONE monotone fixpoint over `RuntimeEffects` — the same effect set the
// runtime ABI rows carry, so a call into the runtime is seeded from the ABI
// table instead of a list maintained per analysis.
//
// Every "I cannot see this" answer defaults to every effect at once. Proving
// something safe requires evidence; the absence of evidence proves nothing.

// A pure chain. No body here holds a seed, so the fixpoint proves the whole
// chain cannot panic and the backend drops its landing pads.
fn double(n: i64) -> i64 {
    return n + n;
}

fn quadruple(n: i64) -> i64 {
    return double(double(n));
}

// Division carries a language-level guard, which is a MAY_PANIC seed on this
// body alone. The seed then reaches every caller through the same fixpoint.
fn ratio(total: i64, count: i64) -> i64 {
    return total / count;
}

fn average(total: i64, count: i64) -> i64 {
    return ratio(total, count);
}

// `average` never mentions `panic`. It is reported as may-panic purely because
// the seed on `ratio` propagates, which is what keeps the landing pad here.
fn guarded_average(total: i64, count: i64) {
    if true {
        defer match recover() {
            Some(info) => println("recovered: " + info.message),
            None => println("no panic")
        }

        println(average(total, count));
    }
}

// The call graph the fixpoint runs over reads names through the walker's real
// lexical scope stack, not a flat "every name bound anywhere in this body" set.
// Two things follow, and both change which edges the fixpoint sees:
//
//   * a binding stops shadowing once its scope closes, so `weigh` is a static
//     edge again after the inner block ends instead of an unknown call for the
//     rest of the body, and
//   * a receiver's class does not outlive its binding. The flat map kept the
//     inner `sample`'s class after that scope closed, resolved the outer call
//     against the wrong class, and never saw the panicking body — a landing pad
//     dropped by a shadow, which is the fail-OPEN direction.
class Quiet {
    pub fn value(self) -> i64 {
        return 1;
    }
}

class Loud {
    pub fn value(self) -> i64 {
        panic("Loud has no value");
        return 0;
    }
}

fn weigh(n: i64) -> i64 {
    return n * 3;
}

fn shadowed_scopes() {
    if true {
        defer match recover() {
            Some(info) => println("recovered: " + info.message),
            None => println("no panic")
        }

        if true {
            let weigh = |n: i64| -> i64 { return n; };
            println(weigh(2));       // 2, through the local function value
        }
        println(weigh(2));           // 6, through the real helper again

        let sample = new Loud();
        if true {
            let sample = new Quiet();
            println(sample.value()); // 1
        }
        println(sample.value());     // panics, and the landing pad catches it
    }

    println("after the shadowed scopes");
}

// E0810 rejects a *synchronous* helper that loops or recurses when it is called
// from task context, because nothing can preempt its stack. Recursion is its
// own seed: unbounded work needs no `while`. The remedy the diagnostic names is
// exactly this — make the helper async, so every step is a scheduler safepoint.
async fn sum_to(n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    return n + await sum_to(n - 1);
}

class Meter {
    pub reading: Mutex<i64>;

    // A waiting body. `recv` blocks until a value arrives.
    pub async fn slow_reading(self, ch: Channel<i64>) -> i64 {
        return ch.recv();
    }

    // The critical section calls only bodies the fixpoint proved wait-free, so
    // it is accepted. Writing `await self.slow_reading(ch)` between the braces
    // would be E2604 instead.
    pub async fn record(self, ch: Channel<i64>) {
        let pending = self.slow_reading(ch);
        lock self.reading as mut value {
            value = value + quadruple(1);
        }
        let measured = await pending;
        lock self.reading as mut value {
            value = value + measured;
        }
    }

    pub async fn read(self) -> i64 {
        lock self.reading as value {
            return value;
        }
    }
}

async fn main() {
    println(quadruple(5));           // 20

    guarded_average(10, 2);          // 5 / no panic
    guarded_average(10, 0);          // recovered: ...
    println("after the recover");

    shadowed_scopes();

    println(await sum_to(10));       // 55

    let ch: Channel<i64> = Channel::new();
    ch.send(7);
    let meter = new Meter(Mutex::new(100));
    await meter.record(ch);
    println(await meter.read());     // 111
}
