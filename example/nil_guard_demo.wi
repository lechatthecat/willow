// Demonstrates safe Option access. Match makes both presence and absence
// explicit before any field access or method call.

class Box {
    pub value: i64;

    pub fn is_positive(self) -> bool {
        return self.value > 0;
    }

    pub fn scaled(self, factor: i64) -> i64 {
        return self.value * factor;
    }
}

// Safely read a value — returns 0 when the box is absent.
fn read_or_zero(b: Option<Box>) -> i64 {
    match b {
        Some(value) => return value.value,
        None => return 0,
    }
}

// Call a method only when present.
fn is_positive_safe(b: Option<Box>) -> bool {
    match b {
        Some(value) => return value.is_positive(),
        None => return false,
    }
}

// Compute a scaled value or use an explicit fallback.
fn scaled_or_default(b: Option<Box>, factor: i64, default_val: i64) -> i64 {
    match b {
        Some(value) => return value.scaled(factor),
        None => return default_val,
    }
}

fn main() {
    let pos = new Box(42);
    let neg = new Box(-7);
    let maybe_pos: Option<Box> = Some(pos);
    let maybe_neg: Option<Box> = Some(neg);
    let nothing: Option<Box> = None;

    // Field access after opening Some.
    println(read_or_zero(maybe_pos));  // 42
    println(read_or_zero(maybe_neg)); // -7
    println(read_or_zero(nothing));   // 0

    // Method call after opening Some.
    println(is_positive_safe(maybe_pos)); // true
    println(is_positive_safe(maybe_neg)); // false
    println(is_positive_safe(nothing));   // false

    // Optional value with a default fallback.
    println(scaled_or_default(maybe_pos, 3, 0));  // 126
    println(scaled_or_default(nothing,   3, 99)); // 99
}
