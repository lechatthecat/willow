// Tail values, `new` construction, ordinary output names and typed float display.
import std::io::{print, println};

class User {
    pub score: i64;
    pub fn doubled(self) -> i64 { self.score * 2 }
}

fn score(user: User) -> i64 {
    match user.score { 0 => 10, n => n }
}

fn choose(value: bool) -> i64 {
    if value { let answer = 7; answer } else { 9 }
}

fn main() {
    let user = new User(2);
    print("score=");
    println(score(user));
    println(user.doubled());
    println(choose(true));
    let plus = |x: i64| { x + 1 };
    println(plus(4));
    println(2.0);
    println((-0.0).to_string());
}
