// Nested patterns, let chains and omitted enum names.
//
// A pattern may nest to any depth: a variant inside a variant, an enum inside
// another enum's payload, tuples holding options. Inside a pattern whose
// expected type is a known enum, the enum name may be left out (`Some(x)`,
// `Circle(r)`); an unknown or ambiguous bare name is a compile error.
// `if let A = x && let B = y && cond { ... }` runs the block only when every
// step matches, left to right; each step sees the bindings before it.
// Exhaustiveness understands nesting: a missing case such as
// `Ok(Option::None)` is reported, and an arm that can never match warns.

import std::collections::Array;

enum Shape { Circle(i64), Rect(i64, i64) }
enum Color { Red, Green }
enum Item { Painted(Shape, Color), Plain(Option<Shape>) }

fn area(s: Shape) -> i64 {
    return match s {
        Circle(r) => 3 * r * r,
        Rect(w, h) => w * h,
    };
}

fn describe(item: Item) -> String {
    return match item {
        Item::Painted(Circle(r), Red) => "red circle " + r.to_string(),
        Item::Painted(Rect(w, h), _) if w == h => "square",
        Item::Painted(shape, Green) => "green " + area(shape).to_string(),
        Item::Painted(_, Red) => "red other",
        Item::Plain(Some(shape)) => "plain " + area(shape).to_string(),
        Item::Plain(None) => "nothing",
    };
}

fn parse(r: Result<Option<i64>, String>) -> String {
    return match r {
        Ok(Some(0)) => "zero",
        Ok(Some(n)) => "number " + n.to_string(),
        Ok(None) => "empty",
        Err(e) => "error " + e,
    };
}

fn total(pair: (Option<i64>, Option<i64>), limit: i64) -> i64 {
    if let (Some(a), Some(b)) = pair && a + b < limit {
        return a + b;
    }
    return -1;
}

fn first_plain(items: Array<Item>) -> i64 {
    for item in items {
        let Item::Plain(Some(shape)) = item else { continue; };
        return area(shape);
    }
    return 0;
}

fn main() {
    println(describe(Item::Painted(Shape::Circle(2), Color::Red)));
    println(describe(Item::Painted(Shape::Rect(3, 3), Color::Red)));
    println(describe(Item::Painted(Shape::Rect(2, 5), Color::Green)));
    println(describe(Item::Painted(Shape::Rect(2, 5), Color::Red)));
    println(describe(Item::Plain(Some(Shape::Circle(1)))));
    println(describe(Item::Plain(None)));
    println(parse(Ok(Some(0))));
    println(parse(Ok(Some(7))));
    println(parse(Ok(None)));
    println(parse(Err("bad input")));
    println(total((Some(2), Some(3)), 10));
    println(total((Some(8), Some(3)), 10));
    println(total((None, Some(3)), 10));
    let items: Array<Item> = [Item::Painted(Shape::Circle(1), Color::Green), Item::Plain(None), Item::Plain(Some(Shape::Rect(4, 6)))];
    println(first_plain(items));
}
