// Synchronous `defer` scopes that cross LIR blocks (willow-0g8j.2.15).
//
// A `defer` scope is left by more than fallthrough: an explicit `return`, a
// `break`, a `continue`, or a `?` that propagates all leave early, and each of
// those has to run the pending defers of every scope it unwinds, innermost
// first. On the LIR walker both halves of that used to be missing — `flush
// defers` was emitted but did nothing on the synchronous path, and eligibility
// only checked that a block's own scope pushes and pops balanced — so any
// function with an early exit out of a `defer` scope fell back to the AST
// backend. Every function below now compiles from the lowered IR.
//
// The `merged_*` functions below pin the second half of that: the scope stack
// travels along the CFG edges, and a LIR block index is not a position in that
// graph. An `if/else` lowers as then -> merge -> else, so the merge block has a
// LOWER index than the `else` arm that is its only live predecessor, and an
// emitter walking indices would reach it before anything had told it which
// scopes are open (willow-fvt4).

fn doubled(n: i64) -> i64 {
    defer println("leave doubled");
    let x = n * 2;
    return x; // flush + return, all inside one block
}

fn pick(n: i64) -> i64 {
    defer println("leave pick");
    if n > 0 {
        defer println("leave positive");
        return 1; // two scopes unwound, innermost first
    }
    return 0; // only the outer scope is open here
}

fn first_big(limit: i64) -> i64 {
    defer println("leave first_big");
    for i in 0..limit {
        defer println(i);
        if i * i > 5 {
            return i; // out of the loop body AND the function scope
        }
    }
    return -1;
}

fn deep(limit: i64) -> i64 {
    defer println("leave deep");
    for i in 0..limit {
        defer println(i);
        if i > 0 {
            defer println("leave inner");
            if i == 2 {
                return i; // three scopes at once, innermost first
            }
        }
    }
    return -1;
}

fn scan(limit: i64) -> i64 {
    let mut total = 0;
    for i in 0..limit {
        defer println(i * 100);
        if i == 1 {
            continue; // one iteration's scope
        }
        if i == 3 {
            break; // the loop body's scope, then out of the loop
        }
        total = total + i;
    }
    return total;
}

fn merged(flag: bool) -> i64 {
    defer println("leave merged");
    if flag {
        return 1; // the `then` arm exits, so it never reaches the merge
    } else {
        println("else");
    }
    return 2; // merge block: its only live predecessor is the `else` arm
}

fn merged_scope(flag: bool) -> i64 {
    defer println("leave merged_scope");
    for i in 0..1 {
        defer println(i + 70);
        if flag {
            return 1;
        } else {
            println("scoped else");
        }
        // The loop body's own scope is left by fallthrough, and the block that
        // does the leaving is that same merge — so the state it unwinds has to
        // have arrived from the `else` arm, not from a default.
    }
    return 2;
}

fn merged_loop(limit: i64) -> i64 {
    defer println("leave merged_loop");
    let mut total = 0;
    for i in 0..limit {
        defer println(i * 10);
        if i == 2 {
            break; // out of the body scope and the loop
        } else {
            total = total + i;
        }
    }
    return total;
}

fn parse(n: i64) -> Result<i64, String> {
    defer println("leave parse");
    if n < 0 {
        return Err("negative");
    }
    return Ok(n * 10);
}

fn scaled(a: i64, b: i64) -> Result<i64, String> {
    defer println("leave scaled");
    let x = parse(a)?; // a propagating `?` unwinds this scope too
    let y = parse(b)?;
    return Ok(x + y);
}

fn main() {
    defer println("bye");

    println(doubled(3));
    println(pick(5));
    println(pick(-1));
    println(first_big(9));
    println(deep(5));
    println(scan(6));
    println(merged(false));
    println(merged(true));
    println(merged_scope(false));
    println(merged_scope(true));
    println(merged_loop(5));

    match scaled(1, 2) {
        Ok(n) => println(n),
        Err(e) => println(e),
    }
    match scaled(1, -2) {
        Ok(n) => println(n),
        Err(e) => println(e),
    }
}
