// Module constants accept scalar and String literals.
// Build a constant array once as a frozen class static property: a function
// returning an array literal would allocate a new array on every call.
class Words {
    pub static values: FrozenArray<String> = ["alpha", "beta"].freeze();
}

fn main() {
    let values = Words::values;
    println(values[0]);
    println(Words::values[1]);
}
