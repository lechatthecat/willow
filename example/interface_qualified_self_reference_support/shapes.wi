// An interface whose signatures name itself and a sibling interface. The
// provider spells them bare; implementing classes in other files write the
// qualified or aliased path, and both must mean the same interface.
pub interface Shape {
    fn area(self) -> i64;
    fn scaled(self, factor: i64) -> Shape;
    fn bigger(self, other: Shape) -> Shape;
}

pub open class Factory {
    pub open fn make(self) -> Shape { return new Unit(); }
}

pub class Unit implements Shape {
    pub fn area(self) -> i64 { return 1; }
    pub fn scaled(self, factor: i64) -> Shape { return self; }
    pub fn bigger(self, other: Shape) -> Shape { return other; }
}
