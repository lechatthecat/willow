// Explicit conversion with to_string() — Willow keeps `+` String-only, so
// non-String values must be converted before concatenation.

class Point {
    pub x: i64;
    pub y: i64;
    pub fn to_string(self) -> String {
        return "(" + self.x.to_string() + ", " + self.y.to_string() + ")";
    }
}

fn main() {
    println("answer = " + 42.to_string());
    println("ok = " + true.to_string());
    println("pi = " + 3.5.to_string());
    let p = new Point(3, 4);
    println("p = " + p.to_string());
}
