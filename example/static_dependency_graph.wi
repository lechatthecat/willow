// Supported: direct/helper dependencies initialize before their consumers.
// Runtime callbacks must be started after startup, as main demonstrates below.
import std::collections::Array;
import std::parallel as par;

class Answer {
    pub static value: i64 = compute();
}
fn compute() -> i64 {
    return Inputs::base + Inputs::offset;
}
class Inputs {
    pub static offset: i64 = 2;
    pub static base: i64 = 40;
}
fn add_offset(value: i64) -> i64 {
    return value + Inputs::offset;
}
async fn main() {
    let values: Array<i64> = [Answer::value - Inputs::offset];
    let mapped = await par::map(values.freeze(), add_offset);
    println(mapped[0]); // 42: callback work begins after static initialization.
}

