// Parentheses read a callable field before invoking it.
// Direct receiver.f(args) retains method dispatch.
class Plain {
    pub f: closure(i64) -> i64;
    pub fn run(self, x: i64) -> i64 {
        return (self.f)(x);
    }
}
class Box<T> {
    pub f: closure(T) -> T;
    pub fn run(self, x: T) -> T {
        return ((self.f))(x);
    }
}
fn main() {
    let offset = 7;
    let plain = new Plain(|x: i64| x + offset);
    let boxed = new Box<i64>(|x: i64| x * offset);
    println(plain.run(3));
    println(boxed.run(3));
}
