// GC-managed linked list with explicit Option references.

class Node {
    pub value: i64;
    pub next: Option<Node>;
}

fn sum(list: Option<Node>) -> i64 {
    let mut current: Option<Node> = list;
    let mut total = 0;

    while current.is_some() {
        let node = current.unwrap();
        total = total + node.value;
        current = node.next;
    }

    return total;
}

fn main() {
    let list = new Node(1, Some(new Node(2, Some(new Node(3, None)))));
    println(sum(Some(list)));
}
