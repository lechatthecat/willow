// Default: a shallow synchronous helper on a task-owned stack prints 8.
// Pass any argument to demonstrate the fatal task-stack overflow diagnostic.
import std::collections::Array;

fn dive(depth: i64) -> i64 {
    if depth == 0 { return 0; }
    return dive(depth - 1) + 1;
}

async fn main(args: Array<String>) {
    let depth = args.len() == 0 ? 8 : 10000000;
    println(dive(depth));
}
