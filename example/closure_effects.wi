// Body-based semantic effects: synchronous comparators are non-blocking,
// while a synchronous closure calling BlockingCell::get retains MAY_BLOCK.
class Heap {
    pub compare: closure(i64, i64) -> bool;
    pub init(self, compare: closure(i64, i64) -> bool) {
        self.compare = compare;
    }
    pub fn before(self, a: i64, b: i64) -> bool {
        let callback = self.compare;
        return callback(a, b);
    }
}
class Dijkstra {
    pub fn route(self) -> bool {
        let offset = 1;
        let heap = new Heap(|a: i64, b: i64| a + offset < b);
        return heap.before(1, 3);
    }
}
fn apply(f: closure() -> bool) -> bool { return f(); }
fn main() {
    let route = new Dijkstra();
    println(route.route());
    let cell = BlockingCell::new(false);
    let f: closure() -> bool = || cell.get();
    println(apply(f));
}
