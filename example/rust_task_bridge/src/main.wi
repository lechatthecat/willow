extern rust {
    nonblocking("9444fb4ae2af2173a876aecb492ff9daf29306ca50522fd595daeff668e13b8c") fn is_identifier(text:String)->bool;
}
async fn validate(text:String)->bool { return is_identifier(text); }
async fn main() {
    let first = validate("hello_42");
    let second = validate("42hello");
    println(await first);
    println(await second);
}
