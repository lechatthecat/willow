// The executable models and their limits are described in formal/README.md.
import std::collections::Array;

async fn increment(values: Array<i64>) {
    await yield();
    values[0] = values[0] + 1;
}

fn add_one(value: i64) -> i64 {
    return value + 1;
}

async fn main() {
    let values = [40];
    let alias = values;
    let child = increment(values);
    await child;
    let first = Mutex::new(alias[0]);
    let second = Mutex::new(0);
    lock first as value {
        lock second as mut result {
            result = add_one(value);
        }
    }
    lock second as result { println(result); }
}
