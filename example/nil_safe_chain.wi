// Linked-list operations with explicit Option handling. Optional values are
// opened with match before their fields or methods are used.

class Node {
    pub value: i64;
    pub next: Option<Node>;

    pub fn doubled(self) -> i64 {
        return self.value * 2;
    }
}

// Sum all values in the chain (recursive).
fn sum(node: Option<Node>) -> i64 {
    match node {
        Some(value) => return value.value + sum(value.next),
        None => return 0,
    }
}

// Count nodes in the chain (recursive).
fn length(node: Option<Node>) -> i64 {
    match node {
        Some(value) => return 1 + length(value.next),
        None => return 0,
    }
}

// Return the value of the last node, or -1 if empty.
fn last_value(node: Option<Node>) -> i64 {
    match node {
        Some(value) => match value.next {
            Some(next) => return last_value(Some(next)),
            None => return value.value,
        },
        None => return -1,
    }
}

// Sum of doubled values using a method call on each node.
fn sum_doubled(node: Option<Node>) -> i64 {
    match node {
        Some(value) => return value.doubled() + sum_doubled(value.next),
        None => return 0,
    }
}

fn main() {
    let c = new Node(30, None);
    let b = new Node(20, Some(c));
    let a = new Node(10, Some(b));

    println(sum(Some(a)));           // 60
    println(length(Some(a)));        // 3
    println(last_value(Some(a)));    // 30
    println(last_value(None));       // -1
    println(sum_doubled(Some(a)));   // 120
}
