@pure
@verified
fn larger(a: i64, b: i64) -> i64
    ensures result >= a
    ensures result >= b
    ensures result == a || result == b
{
    if a >= b { return a; }
    return b;
}

@pure
@verified
fn quotient() -> i64 ensures result == -3 { return -7 / 2; }

@pure
@verified
fn remainder() -> i64 ensures result == -1 { return -7 % 2; }

fn main() {
    println(larger(4, 9));
    println(quotient());
    println(remainder());
}
