// Runtime-owned Map buffers/string keys and Channel buffers count toward
// GC memory telemetry and WILLOW_GC_MEMORY_LIMIT. Rust regression tests verify
// the byte gauge; this example exercises the generated-code ownership paths.
import std::collections::Map;

fn main() {
    let keys: Map<String, i64> = Map::new();
    let queue = Channel<i64>::new();
    let mut i: i64 = 0;
    while i < 1024 {
        let key = format("native-key-{}", i);
        keys.insert(key, i);
        keys.insert(key, i + 1);
        queue.send(i);
        i = i + 1;
    }
    let copy = keys.freeze();
    gc_collect();
    println(keys.len()); // 1024
    println(copy.get("native-key-1023").unwrap()); // 1024
    let mut total: i64 = 0;
    i = 0;
    while i < 1024 {
        total = total + queue.recv();
        i = i + 1;
    }
    println(total); // 523776
}
