import std::collections::Array;

class Order { pub price: i64; pub name: String; }

fn main() {
    let values = Array::with_len(3, 7);
    values.insert(1, 2);
    println(values.remove(0));
    values.sort();
    println(values.toString());
    println(values.slice(1, 3).toString());
    println(values.contains(2));
    println(values.index_of(7).unwrap());
    values.fill(4);
    values.swap(0, 2);
    println(values.toString());

    let orders = [new Order(30, "third"), new Order(10, "first"), new Order(20, "second")];
    let ascending = true;
    orders.sort_by(|a, b| { return ascending && a.price < b.price; });
    for order in orders { println(order.name); }
}
