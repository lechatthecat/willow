// std::fs file I/O with Result<_, IoError> errors. Unsuffixed operations are
// synchronous compatibility APIs. In async code, use the `_async` operations:
// they run in the scheduler's blocking pool and do not block a worker.
// fs::temp_path yields a process-unique path, so parallel runs do not collide.

import std::fs;

fn save_and_load(path: String) -> Result<String, IoError> {
    fs::write_string(path, "saved by willow")?;
    let text = fs::read_to_string(path)?;
    fs::remove_file(path)?;
    return Ok(text);
}

async fn main() {
    let path = fs::temp_path("willow_file_io_demo");
    match save_and_load(path) {
        Ok(text) => println(text),
        Err(e) => {
            match e {
                Failed(msg) => println(msg),
            }
        }
    }

    match fs::read_to_string(path) {
        Ok(text) => println(text),
        Err(e) => println("missing file handled"),
    }

    println(fs::exists(path));

    let async_path = fs::temp_path("willow_file_io_async_demo");
    match await fs::write_string_async(async_path, "saved asynchronously") {
        Ok(value) => {}
        Err(error) => println("async write failed"),
    }
    match await fs::read_to_string_async(async_path) {
        Ok(text) => println(text),
        Err(error) => println("async read failed"),
    }
    match await fs::remove_file_async(async_path) {
        Ok(value) => {}
        Err(error) => println("async remove failed"),
    }
    println(await fs::exists_async(async_path));
}
