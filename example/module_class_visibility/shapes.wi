module shapes;

// One of TWO modules in this project that declare a class named `Point`. The
// entry file imports this one and never mentions `grid`, so a bare `Point` in
// the entry means this class (willow-vtlr).
pub class Point {
    pub x: i64;
    pub y: i64;

    pub fn sum(self) -> i64 {
        return self.x + self.y;
    }
}

pub fn make(x: i64, y: i64) -> Point {
    return new Point(x, y);
}

pub fn sum_of(p: Point) -> i64 {
    return p.sum();
}

pub fn shifted(p: Point, by: i64) -> Point {
    return new Point(p.x + by, p.y + by);
}
