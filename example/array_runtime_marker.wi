// Runtime-only helpers keep their entry diagnostic marker through array work.
import std::collections::Array;

fn integers(n: i64) -> i64 {
    let xs: Array<i64> = [];
    let mut i = 0;
    while i < n { xs.push(i); i = i + 1; }
    let mut sum = 0;
    i = 0;
    while i < xs.len() { xs[i] = i + 1; sum = sum + xs[i]; i = i + 1; }
    return sum;
}

fn flags(n: i64) -> i64 {
    let xs: Array<bool> = [];
    let mut i = 0;
    while i < n { xs.push(false); i = i + 1; }
    let mut count = 0;
    i = 0;
    while i < xs.len() { xs[i] = true; if xs[i] { count = count + 1; } i = i + 1; }
    return count;
}

fn floats(n: i64) -> i64 {
    let xs: Array<f64> = [];
    let mut i = 0;
    while i < n { xs.push(1.25); i = i + 1; }
    let mut count = 0;
    i = 0;
    while i < xs.len() { xs[i] = -2.5; if xs[i] == -2.5 { count = count + 1; } i = i + 1; }
    return count;
}

fn main() {
    let sizes = [0, 1, 4, 5, 8, 9, 129];
    let mut i = 0;
    while i < sizes.len() {
        let n = sizes[i];
        println(integers(n) == n * (n + 1) / 2);
        println(flags(n) == n);
        println(floats(n) == n);
        i = i + 1;
    }
}
