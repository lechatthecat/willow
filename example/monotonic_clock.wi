// test: manual -- prints a nondeterministic elapsed time; checked by monotonic_clock_example_runs.
import std::time;

async fn main() {
    let start = time::now_ns();
    await sleep(10);
    let elapsed = time::now_ns() - start;
    println("Elapsed nanoseconds:");
    println(elapsed);
    println(elapsed >= 10000000);
}
