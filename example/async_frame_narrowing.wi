// async_frame_narrowing.wi -- which async locals need a heap frame slot.
//
// An async fn's locals live in a GC-allocated frame so they survive the poll
// function returning to the scheduler. Not all of them have to: willow-lpn.10
// runs a backward liveness analysis and gives a frame slot only to the bindings
// that are live across a suspension. Everything here is ordinary Willow -- the
// narrowing is invisible at the source level -- but each function below is
// shaped to land on a different side of the analysis, and they all have to print
// the same numbers with or without it.
//
// WHAT COUNTS AS A SUSPENSION, TODAY. Not just `await`. The cooperative backend
// plants a preemption safepoint before EVERY statement, and a tripped safepoint
// returns from the poll fn, so every statement boundary is a suspension point.
// That makes the comments below read a little oddly: `scratch` in the first
// function is dead before the *await* and still gets a frame slot, because it is
// live across the safepoint in front of the println that reads it. Under the
// current placement only a local that is never read after its declaring
// statement can be narrowed away -- see `unread_gc_local`. Moving safepoints to
// loop back edges and call sites (willow-mpvo) is what would let the rest of
// these narrow; the analysis is already the general one and needs no change for
// that, which is why the distinctions below are worth spelling out now.
//
// Compile with WILLOW_ASYNC_FRAME_ALL=1 to turn the narrowing off; the output
// must not change.

// Dead before the await: `scratch` is consumed by the println above it and never
// read again. The analysis needs nothing of it past that println -- though the
// safepoint in front of the println is itself a suspension, so today it is
// framed anyway.
async fn dead_before_await(n: i64) -> i64 {
    let scratch = n * 2;
    println(scratch);
    await sleep(1);
    return n;
}

// Live across the suspension: `kept` is written before the await and read after
// it, so its value has to survive the poll return.
async fn live_across_await(n: i64) -> i64 {
    let kept = n + 100;
    await sleep(1);
    return kept;
}

// The loop trap. `carried` is read TEXTUALLY BEFORE the await, but the back edge
// means that read executes AFTER the await on every iteration but the first, so
// `carried` is live across it. A rule that just looked at source order would get
// this wrong in the direction that loses data.
async fn loop_carried(n: i64) -> i64 {
    let mut carried = n;
    let mut i = 0;
    while i < 3 {
        carried = carried + i;
        await sleep(1);
        i = i + 1;
    }
    return carried;
}

// Only one branch reads it after the await, which is enough: liveness merges
// branches by union.
async fn branch_union(n: i64) -> i64 {
    let maybe = n + 7;
    await sleep(1);
    if n > 0 {
        return maybe;
    }
    return 0;
}

// Shadowing. The inner `value` is a different binding from the outer one, and
// each is judged on its own -- the analysis never merges them. The inner one
// crosses the await; the outer one is dead by then and only the per-statement
// safepoint in front of its println keeps it framed.
async fn shadowed(n: i64) -> i64 {
    let value = n;
    println(value);
    if n > 0 {
        let value = n * 10;
        await sleep(1);
        return value;
    }
    return 0;
}

// A GC-managed local is judged on liveness alone -- the type does not enter into
// it, in either direction. `label` is a String and is framed here, for exactly
// the same reason an i64 would be: the safepoint before the println that reads
// it is a suspension it is live across.
async fn gc_local_dead_at_suspend(n: i64) -> i64 {
    let label = "task";
    println(label);
    await sleep(1);
    return n;
}

// The other direction, and the one narrowing that survives today's safepoint
// placement: `unused` is never read, so it is live nowhere and gets no frame
// slot even though it is GC-managed. That is safe because willow-p42j makes the
// cooperative emitter balance the shadow-stack root at every poll return and
// hand the resume trampoline a null-initialized slot, so an unframed GC local is
// fine in an ordinary poll-fn stack slot.
async fn unread_gc_local(n: i64) -> i64 {
    let unused = "task";
    await sleep(1);
    return n;
}

// A GC-managed local that really does cross the suspension.
async fn gc_local_across_await(n: i64) -> i64 {
    let greeting = "hello";
    await sleep(1);
    println(greeting);
    return n;
}

async fn main() {
    println(await dead_before_await(1));
    println(await live_across_await(2));
    println(await loop_carried(10));
    println(await branch_union(5));
    println(await shadowed(3));
    println(await gc_local_dead_at_suspend(4));
    println(await unread_gc_local(7));
    println(await gc_local_across_await(6));
}
