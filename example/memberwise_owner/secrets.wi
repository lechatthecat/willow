module secrets;

pub class Plain {
    value: i64;
    pub static fn make(x: i64) -> Plain { return new Plain(x); }
    pub fn copy(self) -> Plain { return new Plain(self.value); }
    pub fn get(self) -> i64 { return self.value; }
}

pub class Gen<T> {
    value: T;
    pub static fn make(x: T) -> Gen<T> { return new Gen<T>(x); }
    pub fn copy(self) -> Gen<T> { return new Gen<T>(self.value); }
    pub fn get(self) -> T { return self.value; }
}
