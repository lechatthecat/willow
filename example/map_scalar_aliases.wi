// Tasks share one map through one Mutex. Wrapping the same map in two
// mutexes, or using the original alias after the transfer, is rejected at
// compile time (E2408), so every access below goes through the lock.
import std::collections::Map;

async fn fill(wrapper: Mutex<Map<i64, i64>>, base: i64) {
    let mut i = 0;
    while i < 4096 {
        lock wrapper as values {
            values.insert(base + i, (base + i) * 3 + 1);
            values.contains(base + i);
            values.get(base + i);
            values.len();
        }
        i = i + 1;
    }
}

async fn exercise(extra_writer: bool) {
    let values: Map<i64, i64> = Map::new();
    let shared = Mutex::new(values);
    let first = fill(shared, 0);
    let second = fill(shared, 4096);
    let mut expected = 8192;
    if extra_writer {
        let mut i = 8192;
        while i < 12288 {
            lock shared as values {
                values.insert(i, i * 3 + 1);
                if i % 256 == 0 {
                    // Copy and display run under the same lock as the writers.
                    let snapshot = values.freeze();
                    if snapshot.get(i).unwrap() != i * 3 + 1 { println("bad copy"); }
                    values.toString();
                }
            }
            i = i + 1;
        }
        expected = 12288;
    }
    await first;
    await second;
    lock shared as values {
        let mut valid = values.len() == expected;
        let mut key = 0;
        while key < expected {
            let found = match values.get(key) { Some(value) => value, None => -1 };
            if found != key * 3 + 1 { valid = false; }
            key = key + 1;
        }
        println(values.len());
        println(valid);
    }
}

async fn main() {
    await exercise(false); // two tasks writing through one mutex
    await exercise(true);  // plus the caller writing under the same lock
}
