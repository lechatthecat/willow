// Cumulative traffic survives collection; occupied heap bytes can decrease.
class AllocationSample { pub value: i64; }
fn allocate(count: i64) -> i64 {
    let mut i = 0;
    let mut sum = 0;
    while i < count {
        let item = new AllocationSample(i);
        sum = sum + item.value;
        i = i + 1;
    }
    return sum;
}
fn main() {
    let before: i64 = gc_total_allocated_bytes();
    let sum = allocate(10000);
    let after: i64 = gc_total_allocated_bytes();
    let occupied = gc_allocated_bytes();
    gc_collect();
    println(sum == 49995000);
    println(after - before >= 80000);
    println(gc_total_allocated_bytes() >= after);
    println(gc_allocated_bytes() < occupied);
    println(gc_total_allocated_bytes() >= gc_allocated_bytes());
}
