// select timeout + task-completion cases (willow-soro):
//   sleep(ms) =>       ready once ms elapsed (deadline fixed at select entry)
//   let v = await t => ready when the task completes (panics if cancelled;
//                      use `let r = await t.result() =>` for `Result<T, Cancelled>`)
// Combined with recv cases they give Go-style "wait with timeout" patterns.

async fn worker() -> i64 {
    await sleep(30);
    return 42;
}

// A task that takes far longer than the timeout it is raced against.
async fn slow_worker() -> i64 {
    await sleep(2000);
    return 1;
}

// A task case is an `await`, so it needs an `async fn` — a select only waits
// up to the nearest timeout deadline, so a slow task cannot make a near
// timeout wait for it.
async fn wait_with_timeout() {
    let t = slow_worker();
    select {
        let v = await t => { println(v); }
        sleep(30) => { println("gave up on the slow worker"); }
    }
}

async fn main() {
    let ch = Channel<i64>::new();

    select {
        let v = ch.recv() => { println(v); }
        sleep(25) => { println("no message in time"); }
    }

    let t = worker();
    select {
        let v = await t => { println(v); }
        sleep(5000) => { println("worker too slow"); }
    }

    await wait_with_timeout();
}
