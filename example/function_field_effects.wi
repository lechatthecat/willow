// Function fields keep their checked comparator bounds through generic methods.
// Query Heap::push and heap_sort with `willow effects ... --source`.
// Expected output: 1, 2, 3 (one per line).
import std::collections::Array;

class Heap<T> {
    pub items: Array<T>;
    pub before: fn(T, T) -> bool;

    pub fn ordered(self, a: T, b: T) -> bool {
        return (self.before)(a, b);
    }

    pub fn push(self, value: T) {
        self.items.push(value);
        let compare = self.before;
        let mut i = self.items.len() - 1;
        while i > 0 {
            if !compare(self.items[i], self.items[i - 1]) {
                break;
            }
            self.items.swap(i, i - 1);
            i = i - 1;
        }
    }
}

fn heap_sort<T>(items: Array<T>, before: fn(T, T) -> bool) -> Array<T> {
    let heap = new Heap<T>([], before);
    for item in items {
        heap.push(item);
    }
    return heap.items;
}

fn main() {
    let heap = new Heap<i64>([], |a: i64, b: i64| a < b);
    if !heap.ordered(1, 2) {
        panic("comparator result");
    }
    let sorted = heap_sort([3, 1, 2], |a: i64, b: i64| a < b);
    for value in sorted {
        println(value);
    }
}
