// Build in release mode. Arguments: tasks (default 2), iterations per task (10000).
// Compare median timings at 1/2/4/8 tasks with 20000000 iterations per task.
// No arguments runs a small deterministic checksum regression.
import std::collections::Array;

class AllocationPair {
    pub a: i64;
    pub b: i64;
}

fn allocate(count: i64) -> i64 {
    let mut sum = 0;
    let mut i = 0;
    while i < count {
        let pair = new AllocationPair(i, sum);
        sum = (pair.a + pair.b) & 1023;
        i += 1;
    }
    return sum;
}

async fn worker(count: i64) -> i64 {
    return allocate(count);
}

async fn main() {
    let count = i64::parse(env::arg(0).unwrap_or("2")).unwrap();
    let iterations = i64::parse(env::arg(1).unwrap_or("10000")).unwrap();
    let tasks: Array<Task<i64>> = [];
    let start = time::now_ns();
    let mut i = 0;
    while i < count {
        tasks.push(worker(iterations));
        i += 1;
    }
    let mut sum = 0;
    for task in tasks {
        sum += await task;
    }
    if env::arg(1).is_some() {
        println("tasks=" + count.toString() + " ns=" + (time::now_ns() - start).toString()
            + " sum=" + sum.toString());
    }
    println(sum == count * allocate(iterations));
}
