// select.wi — wait on multiple channel operations with `select`.
//
// `select` probes its cases: a `recv` case is ready when its channel has a
// value or is closed; a `send` case (unbounded channel) is always ready. The
// first ready case runs. `default` runs when nothing else is ready.
//
// A closed, drained channel makes a `let v = ch.recv()` case ready but its
// receive then panics ("recv on closed empty channel"). To observe close,
// use `let v = ch.recv_opt() =>`: `v` is `Option<T>`, `None` once the
// channel is closed and empty (see channel_close_drain.wi).

async fn producer(ch: Channel<i64>) -> i64 {
    await sleep(1);
    ch.send(42);
    return 0;
}

async fn main() {
    let ch = Channel<i64>::new();

    // Nothing queued yet → `default` runs (non-blocking).
    select {
        let v = ch.recv() => { println(v); }
        default => { println(0); }
    }

    // A producer task feeds the channel; the recv case (no default) drives
    // the scheduler until the value arrives.
    let p = producer(ch);
    select {
        let v = ch.recv() => { println(v); }
    }
    await p;

    // A send case is always ready for an unbounded channel.
    let out = Channel<i64>::new();
    select {
        out.send(7) => { println(out.recv()); }
    }

    // A `recv_opt` case binds `None` when the channel is closed and drained.
    out.close();
    select {
        let v = out.recv_opt() => {
            match v {
                Some(x) => { println(x); }
                None => { println("closed"); }
            }
        }
    }
}
