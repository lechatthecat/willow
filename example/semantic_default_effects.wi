// Default bodies retain their own effects; interface calls also reach overrides.
// willow effects semantic_default_effects::Shape::flat --source example/semantic_default_effects.wi
// willow effects semantic_default_effects::inherited --source example/semantic_default_effects.wi
// Expected output: true, true, false (one per line).
interface Shape {
    fn flat(self) -> bool { return true; }
}
open class Point implements Shape {}
class Child extends Point {}
class Curve implements Shape {
    pub fn flat(self) -> bool { return false; }
}
fn inherited(point: Child) -> bool { return point.flat(); }
fn dispatch(shape: Shape) -> bool { return shape.flat(); }
fn main() {
    println(inherited(new Child()));
    println(dispatch(new Point()));
    println(dispatch(new Curve()));
}
