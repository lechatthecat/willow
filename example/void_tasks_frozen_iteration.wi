// `()` and `void` name the same no-result type, including in Task<()>.
// FrozenArray supports direct for-in iteration.
import std::collections::Array;

async fn work() -> () {}

async fn main() {
    let tasks: Array<Task<()>> = [];
    tasks.push(work());
    tasks.push(work());
    for task in tasks {
        await task;
    }
    let values = [10, 20, 30].freeze();
    let mut total = 0;
    for value in values {
        total += value;
    }
    println(tasks.len()); // 2
    println(total); // 60
}
