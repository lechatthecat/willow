// A non-Sync value can be lent to a task and used again after the task is
// awaited. The loan may start inside a branch or a loop body when the `await`
// runs unconditionally in the same block. Inside a loop, lend only values
// created in the current iteration; `@sending` marks a call result the caller
// owns, so it can be lent like a literal.
import std::collections::Array;

@sending fn batch(n: i64) -> Array<i64> {
    let xs: Array<i64> = [];
    for i in 0..n { xs.push(i); }
    return xs;
}

async fn sum(xs: Array<i64>) -> i64 {
    let mut total = 0;
    for x in xs { total += x; }
    xs.push(total);
    return total;
}

async fn main() {
    for round in 1..4 {
        let row = batch(round + 1);
        let task = sum(row);
        println(await task);
        println(row.len());
    }

    let scores: Array<i64> = [3, 4];
    if scores.len() > 1 {
        println(await sum(scores));
    }
    println(scores[2]);
}
