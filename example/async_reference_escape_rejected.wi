// Async functions may borrow caller storage until their task is discharged.
// These escaping alternatives are rejected with E1708:
// return read(&value);
// let tasks = [read(&value)];
// let task = read(&value); save(task);
// let task = read(&value); // leaving this block without await
//
// E1707 is reserved for unsupported reference types (for example fn pointers).
async fn read(value: &i64) -> i64 {
    await sleep(1);
    return value;
}
async fn main() {
    let value = 42;
    let task = read(&value);
    let result = await task;
    println(result);
}
