// Content keys remain owned across collection; freeze publishes an independent copy.
import std::collections::Map;
fn main() {
 let counts: Map<String, i64> = Map::new();
 counts.insert("日本語" + "🦀", 7);
 counts.insert("", 3);
 gc_collect();
 let snapshot = counts.freeze();
 counts.insert("日本語🦀", 9);
 println(counts.get("日本語🦀").unwrap()); // 9
 println(snapshot.get("日本語🦀").unwrap()); // 7
 println(counts.get("").unwrap()); // 3
 println(counts.contains("missing")); // false
 println(counts.len()); // 2
}
