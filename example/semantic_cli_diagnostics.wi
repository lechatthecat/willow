// Inspect: willow effects main --source example/semantic_cli_diagnostics.wi --all
// Semantic rename follows fields, variants and interface implementation families.
interface Dispatcher { fn assign(self) -> i64; }
class Nearest implements Dispatcher {
    pub fn assign(self) -> i64 { return 1; }
}
class Passenger {
    pub board: i64;
    pub init(self) { self.board = 0; }
}
enum Dir { Idle, Up }
fn dispatch(x: Dispatcher) -> i64 { return x.assign(); }
fn main() {
    let dispatcher = new Nearest();
    let passenger = new Passenger();
    let direction = Dir::Idle;
    println(dispatch(dispatcher));
    println(passenger.board);
    match direction { Dir::Idle => { println(0); }, Dir::Up => { println(1); } };
}
