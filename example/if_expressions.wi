// Expression branches contain a value, without a trailing semicolon.
// Statement-form if remains available for blocks of statements.
fn classify(n: i64) -> String {
    return if n < 0 { "negative" } else if n == 0 { "zero" } else { "positive" };
}

fn main() {
    println(classify(-3));
    println(classify(0));
    println(classify(7));
    let answer = if true { 6 * 7 } else { 0 };
    println(answer);
}
