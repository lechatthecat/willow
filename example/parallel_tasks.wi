// parallel_tasks.wi — concurrent async tasks with await.
//
// Calling an `async fn` creates a lightweight task on Willow's cooperative
// scheduler (not an OS thread).  `await task` waits until that task completes
// and returns its result.  Tasks are cheap, so creating many of them is fine.
//
// Creating multiple tasks and awaiting them all is the basic pattern for
// concurrent computation in Willow.  Awaiting requires an async context, so
// `main` is declared `async`.

// The work a task performs must stay preemptible.  A *synchronous* helper that
// can run unbounded work — a loop, or recursion such as `fib(n - 1) + fib(n - 2)`
// — would hold a scheduler worker until it finished, so calling one from a task
// is rejected with E0810.  See `example/task_recursion_rejected.wi`.
//
// Computing the value inside the `async fn` avoids that: every loop backedge in
// an async fn carries a safepoint, so the task yields to the scheduler as it
// goes.
async fn fib_task(n: i64) -> i64 {
    let mut previous = 0;
    let mut current = 1;
    let mut i = 0;
    while i < n {
        let next = previous + current;
        previous = current;
        current = next;
        i = i + 1;
    }
    return previous;
}

async fn double(x: i64) -> i64 {
    return x * 2;
}

async fn is_positive(x: i64) -> bool {
    return x > 0;
}

async fn main() {
    // Create three independent tasks (an async call returns a Task).
    let a = fib_task(10);
    let b = fib_task(12);
    let c = fib_task(15);

    // `await` waits for each task and returns its result.
    println(await a);   // 55
    println(await b);   // 144
    println(await c);   // 610

    // Non-i64 return types work too.
    let d = double(21);
    let e = is_positive(-5);
    println(await d);   // 42
    println(await e);   // false
}
