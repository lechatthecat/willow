// Recursive and loop polls use the current execution context.
fn left(n: i64) -> i64 {
    if n < 1 { return 1; }
    return right(n - 1) + right(n - 1);
}
fn right(n: i64) -> i64 {
    if n < 1 { return 1; }
    return left(n - 1) + left(n - 1);
}
fn main() {
    let mut i = 0;
    while i < 4 {
        println(left(i));
        i = i + 1;
    }
}
