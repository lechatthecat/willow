// status: future
// feature: exponentiation operator ** on f64
//
// `i64 ** i64` is lowered natively and has a runnable example at
// example/exponentiation.wi (willow-n5yv.3). `f64 ** f64` lexes, parses and
// type-checks with the same operator, but has no backend yet, so every line
// below is currently rejected with:
//
//   error[E2501]: exponentiation `**` on `f64` is not supported by the code
//   generator yet
//
// The float lowering is staged on its own because its result must be pinned
// before it exists: which rounding order the integral fast paths use, what the
// generated log2/exp2 kernels are allowed to do, and how close to correctly
// rounded the general case has to be (willow-n5yv.1 and willow-n5yv.4 through
// willow-n5yv.7). Until that lands, write float powers with the
// `pow(base, exponent)` builtin.
//
// Rules the syntax below relies on:
//
//   * `**` is RIGHT associative:  2.0 ** 3.0 ** 2.0  is  2.0 ** (3.0 ** 2.0)
//   * `**` binds tighter than `*`, `/`, `+`, `-` and comparisons
//   * `**` binds tighter than prefix `-`, so  -2.0 ** 2.0  is  -(2.0 ** 2.0)
//   * a float exponent may be negative without parentheses:  2.0 ** -3.0
//   * there are exactly two signatures: `i64 ** i64 -> i64` and
//     `f64 ** f64 -> f64`; mixing `i64` and `f64` is a type error

fn hypotenuse_squared(a: f64, b: f64) -> f64 {
    return a ** 2.0 + b ** 2.0;
}

fn root(x: f64) -> f64 {
    return x ** 0.5;
}

fn main() {
    // Integral exponents: the value is exactly a multiplication chain, so this
    // is the part with a canonical answer (willow-n5yv.4).
    println(2.0 ** 10.0);
    println(hypotenuse_squared(3.0, 4.0));

    // Right associativity, and precedence over `*` and prefix `-`.
    println(2.0 ** 3.0 ** 2.0);
    println(2.0 * 3.0 ** 2.0);
    println(-2.0 ** 2.0);

    // A negative float exponent is a value, unlike a negative integer one.
    println(2.0 ** -3.0);

    // The general case: a non-integral exponent needs the full kernel
    // (willow-n5yv.5 through willow-n5yv.7).
    println(root(2.0));

    // A power is an ordinary operand elsewhere.
    let big: bool = 2.0 ** 10.0 > 1000.0;
    println(big);
}
