// status: future
// feature: exponentiation operator **
//
// `**` already lexes, parses and type-checks (willow-n5yv.2), but no backend
// lowers it yet, so every line below is currently rejected with:
//
//   error[E2501]: exponentiation `**` is not supported by the code generator yet
//
// This file documents the operator's final shape. When the backend lowering
// lands (willow-n5yv.3) it graduates to a runnable root example. Until then,
// `f64` powers can be written with the `pow(base, exponent)` builtin, and
// `i64` powers with a small helper (see example/arithmetic.wi).
//
// Rules the syntax below relies on:
//
//   * `**` is RIGHT associative:  2 ** 3 ** 2  is  2 ** (3 ** 2)  = 512
//   * `**` binds tighter than `*`, `/`, `%`, `+`, `-` and comparisons
//   * `**` binds tighter than prefix `-`, so  -2 ** 2  is  -(2 ** 2)  = -4
//   * the exponent may be negative without parentheses:  2 ** -3
//   * `await` binds tighter than `**`:  await t ** 2  is  (await t) ** 2
//   * there are exactly two signatures: `i64 ** i64 -> i64` and
//     `f64 ** f64 -> f64`; mixing `i64` and `f64` is a type error

fn cube(n: i64) -> i64 {
    return n ** 3;
}

fn hypotenuse_squared(a: f64, b: f64) -> f64 {
    return a ** 2.0 + b ** 2.0;
}

fn main() {
    // Basic powers.
    println(2 ** 10);
    println(cube(4));

    // Right associativity: 2 ** (3 ** 2), not (2 ** 3) ** 2.
    println(2 ** 3 ** 2);

    // Parentheses override associativity.
    println((2 ** 3) ** 2);

    // `**` binds tighter than `*` and than prefix `-`.
    println(2 * 3 ** 2);
    println(-2 ** 2);
    println((-2) ** 2);

    // Float powers use the same operator.
    println(hypotenuse_squared(3.0, 4.0));

    // A power is an ordinary operand elsewhere.
    let big: bool = 2 ** 10 > 1000;
    println(big);
}
