// status: future
// feature: scheduler-aware lock statement, RwLock forms
//
// The `Mutex` form of `lock` is DONE and graduated to a runnable root example
// (willow-38w.1.4): see example/scheduler_aware_lock.wi. The two RwLock forms
// below still lex, parse and type-check, but no backend lowers them yet, so
// each is rejected with:
//
//   error[E2502]: the `lock` statement is not supported by the code generator yet
//
// The runtime half is the remaining work (willow-38w.1.5): a reader/writer
// variant of the task-based ownership, FIFO waiters and direct handoff that
// `crates/willow_runtime/src/async_mutex.rs` already provides for `Mutex<T>`,
// plus the acquire/release edges the compiler must emit around the body. Until
// that lands, `RwLock::read`/`RwLock::write` (see example/locks.wi) are the way
// to touch a protected value — each a single atomic operation, so a
// read-modify-write built from two of them can lose updates, which is exactly
// the hazard `lock` exists to remove.
//
// Rules the code below relies on:
//
//   * two RwLock forms:  `lock read r as v { .. }`         (shared)
//                        `lock write r as [mut] v { .. }`  (exclusive)
//   * the binding has the PROTECTED type `T`, never a guard type
//   * a `read` binding is never `mut`: a shared view cannot write
//   * the target is evaluated exactly once, before the acquisition, and is not
//     re-evaluated when a contended acquisition resumes
//   * a contended acquisition parks the TASK, never the worker thread, so other
//     tasks keep running on the same thread
//   * V1 restrictions: only inside an `async fn` (E2603), no `await`/`select`
//     inside the body (E2604), and no nested acquisition (E2605)
//   * `lock`, `read` and `write` stay ordinary identifiers everywhere else

// Shared reads do not exclude each other, so many tasks can observe the value
// at once. The binding is not `mut` — `lock read ... as mut v` is a parse error.
async fn observe(settings: RwLock<i64>) -> i64 {
    lock read settings as value {
        return value;
    }
}

// An exclusive write excludes both readers and other writers. As with the
// Mutex form, the lock is released on every exit from the body, so an early
// `return` needs no cleanup of its own.
async fn publish(settings: RwLock<i64>, next: i64) -> bool {
    lock write settings as mut value {
        if next == value {
            return false;
        }
        value = next;
        return true;
    }
}

async fn main() {
    let settings = RwLock::new(1);
    println(await publish(settings, 7));
    println(await publish(settings, 7));
    println(await observe(settings));

    // Sequential critical sections are fine — only NESTING is refused in V1.
    let left = RwLock::new(1);
    let right = RwLock::new(2);
    lock write left as mut a {
        a = a + 1;
    }
    lock write right as mut b {
        b = b + 1;
    }
    println(left.read() + right.read());

    // `lock`, `read` and `write` remain ordinary identifiers: this is a plain
    // local, not a critical section, and `lock read as v { .. }` would lock a
    // Mutex NAMED `read`.
    let lock = 0;
    let read = lock + 1;
    let write = read + 1;
    println(write);
}
