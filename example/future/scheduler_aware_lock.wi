// status: future
// feature: scheduler-aware lock statement
//
// `lock` already lexes, parses and type-checks (willow-38w.1.1), but no backend
// lowers it yet, so every critical section below is currently rejected with:
//
//   error[E2502]: the `lock` statement is not supported by the code generator yet
//
// This file documents the statement's final shape. When the lowering lands
// (willow-38w.1.3 for `Mutex`, willow-38w.1.4 for `RwLock`) it graduates to a
// runnable root example. Until then the only way to touch a protected value is
// `Mutex::get`/`Mutex::set` and `RwLock::read`/`RwLock::write` (see
// example/locks.wi), each a single atomic operation — so a read-modify-write
// built from two of them can lose updates, which is exactly the hazard `lock`
// exists to remove.
//
// Why a statement rather than a guard object: Willow has no destructors and no
// borrow checker, so there is no way to tie a release to a value's lifetime.
// The compiler owns both edges of a lexical critical section instead — the lock
// is released on every exit from the body, including `return`, `break` and a
// propagated error.
//
// Rules the code below relies on:
//
//   * three forms:  `lock m as [mut] v { .. }`         for Mutex<T>
//                   `lock read r as v { .. }`          for RwLock<T> (shared)
//                   `lock write r as [mut] v { .. }`   for RwLock<T> (exclusive)
//   * the binding has the PROTECTED type `T`, never a guard type
//   * a `read` binding is never `mut`: a shared view cannot write
//   * the target is evaluated exactly once, before the acquisition, and is not
//     re-evaluated when a contended acquisition resumes
//   * a contended acquisition parks the TASK, never the worker thread, so other
//     tasks keep running on the same thread
//   * V1 restrictions: only inside an `async fn` (E2603), no `await`/`select`
//     inside the body (E2604), and no nested acquisition (E2605)
//   * `lock`, `read` and `write` stay ordinary identifiers everywhere else

class Account {
    pub balance: Mutex<i64>;

    // A read-modify-write is the whole point: with `get` + `set` another task
    // can interleave between the two calls and one deposit disappears.
    pub async fn deposit(self, amount: i64) {
        lock self.balance as mut value {
            value = value + amount;
        }
    }

    // The lock is released on every exit from the body, so an early `return`
    // needs no cleanup of its own.
    pub async fn withdraw(self, amount: i64) -> bool {
        lock self.balance as mut value {
            if value < amount {
                return false;
            }
            value = value - amount;
            return true;
        }
    }
}

// Shared reads do not exclude each other, so many tasks can observe the value
// at once. The binding is not `mut` — `lock read ... as mut v` is a parse error.
async fn observe(settings: RwLock<i64>) -> i64 {
    lock read settings as value {
        return value;
    }
}

// An exclusive write excludes both readers and other writers.
async fn publish(settings: RwLock<i64>, next: i64) {
    lock write settings as mut value {
        value = next;
    }
}

async fn main() {
    let account = new Account(Mutex::new(100));

    // Two deposits and a withdrawal, each an atomic read-modify-write.
    await account.deposit(50);
    await account.deposit(25);
    let ok = await account.withdraw(60);
    println(ok);

    // A rejected withdrawal leaves the balance untouched.
    let rejected = await account.withdraw(10000);
    println(rejected);

    // `Mutex::get` outside a critical section is still fine for a single read.
    println(account.balance.get());

    // RwLock: one writer, then a reader.
    let settings = RwLock::new(1);
    await publish(settings, 7);
    println(await observe(settings));

    // Sequential critical sections are fine — only NESTING is refused in V1.
    let left = Mutex::new(1);
    let right = Mutex::new(2);
    lock left as mut a {
        a = a + 1;
    }
    lock right as mut b {
        b = b + 1;
    }
    println(left.get() + right.get());

    // `lock`, `read` and `write` remain ordinary identifiers: this is a plain
    // local, not a critical section, and `lock read as v { .. }` would lock a
    // Mutex NAMED `read`.
    let lock = 0;
    let read = lock + 1;
    let write = read + 1;
    println(write);
}
