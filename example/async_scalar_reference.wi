async fn read_i64(value: &i64) -> i64 {
    await sleep(1);
    return value;
}
async fn read_f64(value: &f64) -> f64 {
    await sleep(1);
    return value;
}
async fn read_bool(value: &bool) -> bool {
    await sleep(1);
    return value;
}
async fn main() {
    let number = 42;
    let fraction = 2.5;
    let flag = true;
    let integer_result = await read_i64(&number);
    println(integer_result);
    let fraction_result = await read_f64(&fraction);
    println(fraction_result);
    let flag_result = await read_bool(&flag);
    println(flag_result);
}
