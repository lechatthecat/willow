import native::regex_is_match;


fn main() {
    match regex_is_match("^hello [a-z]+$", "hello willow") {
        Result::Ok(matched) => println(matched),
        Result::Err(error) => println(error),
    };
    match regex_is_match("[", "hello willow") {
        Result::Ok(matched) => println(matched),
        Result::Err(error) => {
            println("Err");
            println(error.len() > 0);
        },
    };
}
