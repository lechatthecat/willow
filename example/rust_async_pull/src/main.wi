// A Rust producer drives events; the Willow consumer parks between requests.
extern rust {
    opaque Source;
    async fn source() -> Source;
    async fn next_request(source: Source) -> Option<String>;
    async fn respond(request: String) -> String;
}
async fn main() {
    let events = await source();
    let mut running = true;
    while running {
        match await next_request(events) {
            Some(request) => { println(await respond(request)); }
            None => { running = false; }
        }
    }
}
