// A Rust producer drives events; the Willow consumer parks between requests.
import native::Source;
import native::respond;

async fn main() {
    use events = await Source::new();
    let mut running = true;
    while running {
        match await events.next_request() {
            Some(request) => { println(await respond(request)); }
            None => { running = false; }
        }
    }
}
